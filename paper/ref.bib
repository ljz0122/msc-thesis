@article{souchayLQAC6SixthRelease2024,
  title = {{{LQAC-6}}: {{Sixth Release}} of the {{Large Quasar Astrometric Catalogue}}: {{A}} Compilation of 2 073 099 Objects with 1 739 187 {{{\emph{Gaia}}}} {{DR3}} Counterparts},
  shorttitle = {{{LQAC-6}}},
  author = {Souchay, J. and Secrest, N. and Sexton, R. and Barache, C.},
