@article{krogager_4mostgaia_2023,
	title = {The 4MOST–Gaia Purely Astrometric Quasar Survey (4G-{PAQS})},
	volume = {pp. 38-41},
	rights = {Copyright European Southern Observatory},
	issn = {0722-6691},
	url = {https://doi.eso.org/10.18727/0722-6691/5310},
	doi = {10.18727/0722-6691/5310},
	abstract = {The 4MOST–Gaia Purely Astrometric Quasar Survey (4G-{PAQS}) will carry out the first large-scale, colour-independent quasar survey selected solely on the basis of astrometry from Gaia. Our main objective is to quantify the selection effects of current colour-selected samples. These colour-selected samples bias our view of the neutral gas and its chemical enrichment because of dust obscuration and reddening of optical colours. Moreover, the broad absorption-line outflows observed in quasars are under-represented by optical colour selection. 4G-{PAQS} will provide the first sample to overcome these challenges and will constrain the physical and chemical properties of gas in galaxies and quasars at cosmic noon.},
	pages = {4 pages},
	journaltitle = {Published in The Messenger vol. 190},
	publisher = {European Southern Observatory ({ESO})},
	author = {Krogager, Jens-Kristian and Leighly, Karen M. and Fynbo, Johan Peter Uldall and Heintz, Kasper Elm and Balashev, Sergei and Bauer, Franz Erik and Berg, Trystyn and Choi, Hyunseop and Christensen, Lise Bech and De Cia, Annalisa and Ellison, Sara and Geier, Stefan and Glikman, Eilat and Gupta, Neeraj and Konstantopoulou, Christina and Kosenko, Daria and Ledoux, Cédric and López, Sebastian and Milvang-Jensen, Bo and Morabito, Leah and Møller, Palle and Noterdaeme, Pasquier and Pettini, Max and Prochaska, Jason Xavier and Raimundo, Sandra and Richard, Johan and Srianand, Raghunathan and Telikova, Ksenia and Terndrup, Donald and Tripp, Todd M. and Vestergaard, Marianne and Zafar, Tayyaba},
	urldate = {2025-06-18},
